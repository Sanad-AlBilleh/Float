# Copy to .env (gitignored) and replace every value. Never commit .env.
# SQL Server needs at least 8 characters with three of: upper case, lower case, digits, symbols.
# The service passwords go into a connection URL, so avoid @ : / ? # in them.
MSSQL_SA_PASSWORD=ChangeMe-Sa-2026
PERSONAL_DB_PASSWORD=ChangeMe-Personal-2026
HOUSEHOLDS_DB_PASSWORD=ChangeMe-Households-2026
# Shared by both services: personal signs login tokens with it, households checks them.
TOKEN_SECRET=change-me-a-long-random-string
# Sent by each service on /internal calls to the other one.
INTERNAL_API_KEY=change-me-another-long-random-string
